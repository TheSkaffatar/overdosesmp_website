{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "overdosesmp-website",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "overdosesmp",
      "database_id": "cc89c84d-5a15-4989-94f4-e5f4124aa42b"
    }
  ]
}
